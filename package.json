{
  "name": "astro-starter",
  "type": "module",
  "version": "0.0.1",
  "description": "A modern, SEO-optimized Astro starter template with comprehensive meta tags, social media integration, and essential web development tools.",
  "author": "Ali Piry",
  "license": "MIT",
  "keywords": [
    "astro",
    "starter",
    "template",
    "seo",
    "web-development",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alipiry/astro-starter.git"
  },
  "bugs": {
    "url": "https://github.com/alipiry/astro-starter/issues"
  },
  "homepage": "https://github.com/alipiry/astro-starter#readme",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "clean": "rimraf dist .astro",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13",
    "astro-seo": "^1.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
